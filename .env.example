# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file — check `git status` before committing to confirm it's not staged.

# OpenAI (used for spend classification in both the n8n POC and the LangSmith eval script)
OPENAI_API_KEY=

# LangSmith
LANGCHAIN_API_KEY=
# IMPORTANT: if your LangSmith account is on the EU workspace, this MUST be the EU endpoint
# or every call will fail with a 403. Confirmed EU endpoint per LangChain's own docs:
LANGCHAIN_ENDPOINT=https://eu.api.smith.langchain.com
LANGCHAIN_PROJECT=capstone-spend-classification-poc

# Google Sheets (used by the n8n workflow's Write to Classified / Write to Needs Review nodes)
# Credential is configured directly in n8n via OAuth2 — not needed here unless you're
# building a separate script that calls the Sheets API directly.
GOOGLE_SHEET_ID=
